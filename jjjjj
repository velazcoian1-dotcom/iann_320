ee:AddSwitch("Eliminar Animacion Weight", function(state)
    local targetId = "3623707777"
    _G.KillMeshActive = state
    if state then
        task.spawn(function()
            while _G.KillMeshActive do
                for _, v in pairs(game.Workspace:GetDescendants()) do
                    if (v:IsA("MeshPart") or v:IsA("SpecialMesh")) and string.find(tostring(v.MeshId), targetId) then
                        v:Destroy()
                    end
                end
                task.wait(1)
            end
        end)
    end
end)

ee:AddSwitch("Lock Position", function(bool)
    if bool then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local cf = hrp.CFrame
            _G.lockPos = RunService.Stepped:Connect(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = cf
                end
            end)
        end
    else
        if _G.lockPos then _G.lockPos:Disconnect() end
    end
end)

