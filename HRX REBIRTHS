ee:AddSwitch("Auto Weight", function(Value)
    _G.AutoWeight = Value
    if Value then
        local tool = LocalPlayer.Backpack:FindFirstChild("Weight")
        if tool then LocalPlayer.Character.Humanoid:EquipTool(tool) end
        task.spawn(function()
            while _G.AutoWeight do
                ReplicatedStorage.rEvents.liftweightsEvent:FireServer(1) -- REMOTE ACTUALIZADO
                task.wait(0.1)
            end
        end)
    end
end)

ee:AddSwitch("Auto Size 2", function(state)
    _G.autoSizeEnabled = state
    if _G.autoSizeEnabled then
        task.spawn(function()
            local remote = game:GetService("ReplicatedStorage"):WaitForChild("rEvents"):WaitForChild("changeSpeedSizeRemote")
            while _G.autoSizeEnabled do
                local character = LocalPlayer.Character
                if character and character:FindFirstChild("Humanoid") then
                    remote:InvokeServer("changeSize", 2)
                end
                task.wait(0.5)
            end
        end)
    end
end)

ee:AddSwitch("Lock Position", function(bool)
    if bool then
        local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local cf = hrp.CFrame
            _G.lockPos = RunService.Stepped:Connect(function()
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = cf
                end
            end)
        end
    else
        if _G.lockPos then _G.lockPos:Disconnect() end
    end
end)

